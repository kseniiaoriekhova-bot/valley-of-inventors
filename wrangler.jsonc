{
  // Cloudflare Worker: гра (статичні файли з dist/) + безкоштовні моделі Workers AI
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valley-of-inventors",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
